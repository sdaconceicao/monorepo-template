{
  "release-type": "node",
  "versioning": "prerelease",
  "prerelease": true,
  "prerelease-type": "rc",
  "packages": {
    "apps/appA": {
      "pull-request-title-pattern": "chore${scope}: deploy ${component} ${version}"
    },
    "libs/libraryA": {
      "pull-request-title-pattern": "chore${scope}: publish ${component} ${version}"
    },
    "libs/libraryB": {}
  },
  "separate-pull-requests": true,
  "label": "autorelease: pending",
  "pull-request-header": ":sparkles: Package is Ready for Release :sparkles:",
  "draft-pull-request": true,
  "changelog-sections": [
    { "type": "BREAKING CHANGE", "section": "⚠️ BREAKING CHANGES" },
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "bug", "section": "Bug Fixes" },
    { "type": "docs", "section": "Chores" },
    { "type": "deps", "section": "Chores" },
    { "type": "chore", "section": "Chores" }
  ]
}
